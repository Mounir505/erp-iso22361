# ---------------------------------------------------------------------------
# Variables d'environnement du lab ISO 22361 — copier en .env puis adapter.
# Données ENTIÈREMENT FICTIVES ; ne jamais réutiliser ces secrets ailleurs.
# ---------------------------------------------------------------------------
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-lab-only

# Secret HMAC du JWT, encodé en Base64 (>= 256 bits).
# Générer : openssl rand -base64 48
JWT_SECRET=change-me-with-openssl-rand-base64-48
JWT_EXPIRATION_MINUTES=120

# Simulateur d'exercice ("faiblesse contrôlée") — DÉSACTIVÉ par défaut.
# À n'activer que dans le lab, le temps de l'exercice (voir docs/scenario-exercice.md).
CRISIS_EXERCISE_ENABLED=false
